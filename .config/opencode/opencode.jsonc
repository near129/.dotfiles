{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "eza *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "jq *": "allow",
      "git branch *": "allow",
      "git config --get *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git rev-parse *": "allow",
      "git status *": "allow",
      "git worktree *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",
      "pnpm build": "allow",
      "pnpm check": "allow",
      "pnpm format": "allow",
      "pnpm lint": "allow",
      "pnpm run check *": "allow",
      "pnpm run lint *": "allow",
      "pnpm run type-check *": "allow",
      "pnpm test": "allow",
      "uv run mypy *": "allow",
      "uv run pyrefly check *": "allow",
      "uv run pytest *": "allow",
      "uv run ruff check *": "allow",
      "uv run ruff format *": "allow",
      "sudo *": "deny",
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
    },
  },
}
